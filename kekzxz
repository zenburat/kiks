-- ESP
local espObjects = {}
local function getESP(p)
    if not HAS_DRAWING then return nil end
    if not espObjects[p] then
        local box = Drawing.new("Square")
        local nm  = Drawing.new("Text")
        local hp  = Drawing.new("Text")
        local tr  = Drawing.new("Line")
        box.Filled = false; box.Thickness = 1.5
        nm.Size = 13; nm.Color = Color3.fromRGB(255,255,255); nm.Outline = true; nm.Center = true
        hp.Size = 11; hp.Color = Color3.fromRGB(100,255,100); hp.Outline = true; hp.Center = true
        tr.Thickness = 1
        espObjects[p] = { box = box, name = nm, health = hp, tracer = tr }
    end
    return espObjects[p]
end
local function hideESP(e) if not e then return end; for _, d in pairs(e) do d.Visible = false end end
local function clearESP(p)
    if espObjects[p] then
        for _, d in pairs(espObjects[p]) do d:Remove() end
        espObjects[p] = nil
    end
end
Players.PlayerRemoving:Connect(clearESP)

RunService.RenderStepped:Connect(function()
    if not HAS_DRAWING then return end
    if not Settings:Get("ESP") then
        for _, e in pairs(espObjects) do hideESP(e) end
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p == player then continue end
        local e = getESP(p); if not e then continue end
        local char = p.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        if not char or not hum or not root or not head or hum.Health <= 0 then hideESP(e); continue end
        if Settings:Get("TeamCheck") and p.Team ~= nil and p.Team == player.Team then hideESP(e); continue end

        local topScr, topOn = camera:WorldToViewportPoint(head.Position + Vector3.new(0, head.Size.Y/2 + 0.1, 0))
        local bottomScr, _  = camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3.1, 0))
        if not topOn then hideESP(e); continue end

        local boxH = math.abs(topScr.Y - bottomScr.Y)
        local boxW = boxH * 0.5
        local vis  = isVisible(camera.CFrame.Position, root.Position)
        local color = vis and THEME.ESP or Color3.fromRGB(255,165,0)

        e.box.Visible = true
        e.box.Size = Vector2.new(boxW, boxH)
        e.box.Position = Vector2.new(topScr.X - boxW/2, topScr.Y)
        e.box.Color = color
        e.name.Visible = true
        e.name.Text = p.DisplayName
        e.name.Position = Vector2.new(topScr.X, topScr.Y - 16)
        e.health.Visible = true
        e.health.Text = tostring(math.floor(hum.Health)) .. " HP"
        e.health.Position = Vector2.new(topScr.X, bottomScr.Y + 2)
        e.tracer.Visible = true
        e.tracer.From = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y)
        e.tracer.To   = Vector2.new(topScr.X, topScr.Y)
        e.tracer.Color = color
    end
end)

