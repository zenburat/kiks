-- SILENT AIM
local silentAimTarget, silentDeathConn, silentAimConn
local function pickSilentTarget(exclude)
    local best, bestDist = nil, math.huge
    local sc = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p == player or p == exclude then continue end
        if Settings:Get("TeamCheck") and p.Team ~= nil and p.Team == player.Team then continue end
        local char = p.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local head = char and char:FindFirstChild("Head")
        if not char or not hum or not head or hum.Health <= 0 then continue end
        local sp, onScreen = camera:WorldToViewportPoint(head.Position)
        if not onScreen then continue end
        local dist = (Vector2.new(sp.X, sp.Y) - sc).Magnitude
        if dist < bestDist then bestDist = dist; best = p end
    end
    return best
end
local function attachSilentTarget(t)
    silentAimTarget = t
    if not t then return end
    local char = t.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if silentDeathConn then silentDeathConn:Disconnect() end
    silentDeathConn = hum.Died:Connect(function()
        silentAimTarget = nil
        task.wait(0.15)
        if Settings:Get("SilentAim") then attachSilentTarget(pickSilentTarget(t)) end
    end)
end
Settings:Connect("SilentAim", function(on)
    if silentAimConn then silentAimConn:Disconnect(); silentAimConn = nil end
    if silentDeathConn then silentDeathConn:Disconnect(); silentDeathConn = nil end
    silentAimTarget = nil
    if not on then return end
    attachSilentTarget(pickSilentTarget(nil))
    silentAimConn = RunService.RenderStepped:Connect(function(dt)
        if not Settings:Get("SilentAim") then return end
        if not silentAimTarget or not silentAimTarget.Character then
            attachSilentTarget(pickSilentTarget(nil)); return
        end
        local char = silentAimTarget.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local head = char and char:FindFirstChild("Head")
        if not head or not hum or hum.Health <= 0 then silentAimTarget = nil; return end
        camera.CFrame = camera.CFrame:Lerp(CFrame.new(camera.CFrame.Position, head.Position + Vector3.new(0,0.15,0)), math.clamp(dt*24,0,1))
    end)
end)

